# URL publica do site. Opcional: sem ela, o layout usa o dominio de
# producao do projeto na Vercel (VERCEL_PROJECT_PRODUCTION_URL), que vira
# o dominio proprio assim que ele for ligado no projeto. Tambem da para
# definir o dominio direto em src/lib/site.ts (site.dominio).
NEXT_PUBLIC_SITE_URL=

# Indexacao: a pagina e indexada por padrao. So o preview da Vercel
# (VERCEL_ENV=preview) sai com noindex, automaticamente.
